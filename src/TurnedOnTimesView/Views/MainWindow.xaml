<Window x:Class="TurnedOnTimesView.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TurnedOnTimesView.Converters"
        mc:Ignorable="d"
        Title="Windows 开关机记录分析工具" 
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 标题栏 -->
            <RowDefinition Height="80"/>
            <!-- 统计面板 -->
            <RowDefinition Height="140"/>
            <!-- 筛选控件 -->
            <RowDefinition Height="70"/>
            <!-- 数据表格 -->
            <RowDefinition Height="*"/>
            <!-- 状态栏 -->
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" CornerRadius="10" Margin="20,20,20,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#667eea" Offset="0"/>
                    <GradientStop Color="#764ba2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" BlurRadius="6" 
                                  Opacity="0.1" Color="Black"/>
            </Border.Effect>
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Windows 开关机记录分析工具" 
                               FontSize="28" FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="系统启动和关机事件的详细分析与监控" 
                               FontSize="16" 
                               Foreground="White" 
                               Opacity="0.9"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 统计面板 -->
        <Grid Grid.Row="1" Margin="20,0,20,10">
            <UniformGrid Rows="1" Columns="5">
                <!-- 总会话数 -->
                <Border Background="White" Margin="8" CornerRadius="10" 
                        BorderBrush="Transparent" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" 
                                          Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="总会话数" FontSize="14" 
                                   Foreground="#666" TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding TotalSessions}" FontSize="24" 
                                   FontWeight="Bold" Foreground="#333" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 正常关机 -->
                <Border Background="White" Margin="8" CornerRadius="10" 
                        BorderBrush="Transparent" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" 
                                          Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="正常关机" FontSize="14" 
                                   Foreground="#666" TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding NormalShutdowns}" FontSize="24" 
                                   FontWeight="Bold" Foreground="#48bb78" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 异常关机 -->
                <Border Background="White" Margin="8" CornerRadius="10" 
                        BorderBrush="Transparent" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" 
                                          Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="异常关机" FontSize="14" 
                                   Foreground="#666" TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding AbnormalShutdowns}" FontSize="24" 
                                   FontWeight="Bold" Foreground="#f56565" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 系统重启 -->
                <Border Background="White" Margin="8" CornerRadius="10" 
                        BorderBrush="Transparent" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" 
                                          Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="系统重启" FontSize="14" 
                                   Foreground="#666" TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SystemRestarts}" FontSize="24" 
                                   FontWeight="Bold" Foreground="#ed8936" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 平均运行时间 -->
                <Border Background="White" Margin="8" CornerRadius="10" 
                        BorderBrush="Transparent" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" 
                                          Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="平均运行时间" FontSize="14" 
                                   Foreground="#666" TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock FontSize="20" FontWeight="Bold" 
                                   Foreground="#667eea" TextAlignment="Center">
                            <TextBlock.Text>
                                <Binding Path="AverageSessionTime" StringFormat="{}{0:F1}h"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <!-- 筛选控件 -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Margin="20,0,20,10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="4" 
                                  Opacity="0.1" Color="Black"/>
            </Border.Effect>
            <Grid Margin="20,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 数据源选择区域 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 数据源选择控件 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="数据来源:" VerticalAlignment="Center" 
                                   Margin="0,0,12,0" FontWeight="600" Foreground="#495057" FontSize="14"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <RadioButton Name="LocalSystemRadio" Content="本机系统日志" 
                                         IsChecked="{Binding IsLocalSystemSelected}"
                                         GroupName="DataSource" 
                                         VerticalAlignment="Center" 
                                         Margin="0,0,15,0" FontWeight="500" 
                                         Foreground="#495057" FontSize="13">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="16" Height="16" 
                                                                CornerRadius="8" 
                                                                BorderBrush="#667eea" 
                                                                BorderThickness="2"
                                                                Background="{TemplateBinding Background}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0">
                                                            <Ellipse Width="6" Height="6"
                                                                     Fill="#667eea"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{TemplateBinding IsChecked, 
                                                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Border>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#667eea"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            
                            <RadioButton Name="EvtxFileRadio" Content="外部.evtx文件" 
                                         IsChecked="{Binding IsEvtxFileSelected}"
                                         GroupName="DataSource" 
                                         VerticalAlignment="Center" 
                                         FontWeight="500" 
                                         Foreground="#495057" FontSize="13">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="16" Height="16" 
                                                                CornerRadius="8" 
                                                                BorderBrush="#667eea" 
                                                                BorderThickness="2"
                                                                Background="{TemplateBinding Background}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0">
                                                            <Ellipse Width="6" Height="6"
                                                                     Fill="#667eea"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{TemplateBinding IsChecked, 
                                                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Border>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#667eea"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- 文件选择区域（仅在选择.evtx文件时显示） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsEvtxFileSelected, 
                                           Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="20,0,0,0">
                        <TextBlock Text="文件路径:" VerticalAlignment="Center" 
                                   Margin="0,0,8,0" FontWeight="500" Foreground="#666"/>
                        <TextBox Text="{Binding EvtxFilePath, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="350" Height="30" VerticalContentAlignment="Center"
                                 BorderBrush="#ddd" BorderThickness="1"
                                 Padding="8,0" AllowDrop="True"/>
                        <Button Content="浏览..." Command="{Binding BrowseEvtxFileCommand}" 
                                Margin="8,0,0,0" Padding="12,6" Height="30"
                                Background="#667eea" Foreground="White" 
                                BorderBrush="#667eea" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#5a67d8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                    <!-- 文件状态指示器 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsEvtxFileSelected, 
                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="#c6f6d5" CornerRadius="12" Padding="8,4"
                                Visibility="{Binding IsEvtxFileValid, 
                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✓ 文件有效" FontSize="12" FontWeight="500" 
                                       Foreground="#22543d"/>
                        </Border>
                        <Border Background="#fed7d7" CornerRadius="12" Padding="8,4"
                                Visibility="{Binding IsEvtxFileInvalid, 
                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✗ 文件无效" FontSize="12" FontWeight="500" 
                                       Foreground="#742a2a"/>
                        </Border>
                    </StackPanel>
                </Grid>
                
                <!-- 传统筛选控件区域 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧筛选控件 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                            <TextBlock Text="开始日期:" VerticalAlignment="Center" 
                                       Margin="0,0,8,0" FontWeight="500" Foreground="#666"/>
                            <DatePicker SelectedDate="{Binding StartDate}" Width="130" Height="30"
                                        BorderBrush="#ddd" BorderThickness="1"/>
                        </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="结束日期:" VerticalAlignment="Center" 
                                   Margin="0,0,8,0" FontWeight="500" Foreground="#666"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="130" Height="30"
                                    BorderBrush="#ddd" BorderThickness="1"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="关机类型:" VerticalAlignment="Center" 
                                   Margin="0,0,8,0" FontWeight="500" Foreground="#666"/>
                        <ComboBox Width="120" Height="30" BorderBrush="#ddd" 
                                  BorderThickness="1" SelectedIndex="0">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="正常关机" />
                            <ComboBoxItem Content="异常关机" />
                            <ComboBoxItem Content="系统重启" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                    
                    <!-- 中间搜索区域 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="搜索:" VerticalAlignment="Center" 
                                   Margin="0,0,8,0" FontWeight="500" Foreground="#666"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="250" Height="30" VerticalContentAlignment="Center"
                                 BorderBrush="#ddd" BorderThickness="1"
                                 Padding="8,0"/>
                        <Button Content="清除" Command="{Binding ClearSearchCommand}" 
                                Margin="8,0,0,0" Padding="12,6" Height="30"
                                Background="#f8f9fa" Foreground="#495057" 
                                BorderBrush="#dee2e6" BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#e9ecef"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                    <!-- 右侧操作按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新" Command="{Binding RefreshCommand}" 
                            Margin="0,0,8,0" Padding="15,6" Height="30"
                            Background="#48bb78" Foreground="White" 
                            BorderBrush="#48bb78" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#38a169"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Content="导出" Command="{Binding ExportCommand}" 
                            Margin="0,0,8,0" Padding="15,6" Height="30"
                            Background="#ed8936" Foreground="White" 
                            BorderBrush="#ed8936" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#dd6b20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Content="重置" Command="{Binding ResetDateRangeCommand}" 
                            Padding="15,6" Height="30"
                            Background="#667eea" Foreground="White" 
                            BorderBrush="#667eea" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5a67d8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" 
                Margin="20,0,20,10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="4" 
                                  Opacity="0.1" Color="Black"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding SessionsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#e2e8f0"
                      VerticalGridLinesBrush="Transparent"
                      RowBackground="White"
                      AlternatingRowBackground="#f7fafc"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Extended">
                
                <!-- 表头样式 -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f7fafc"/>
                        <Setter Property="Foreground" Value="#4a5568"/>
                        <Setter Property="FontWeight" Value="600"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="BorderBrush" Value="#e2e8f0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#edf2f7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                
                <!-- 行样式 -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f7fafc"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#e6f3ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                
                <!-- 单元格样式 -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            
                <DataGrid.Columns>
                    <DataGridTextColumn Header="启动时间" 
                                        Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                        Width="160" SortMemberPath="StartTime"/>
                    
                    <DataGridTextColumn Header="关机时间" 
                                        Binding="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                        Width="160" SortMemberPath="EndTime"/>
                    
                    <DataGridTextColumn Header="持续时间" 
                                        Width="120" SortMemberPath="Duration">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding FormattedDuration}"/>
                                <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="最后事件时间" 
                                        Width="160" SortMemberPath="LastEventTime">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding LastEventTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
                                <Setter Property="Foreground" Value="#495057"/>
                                <Setter Property="FontWeight" Value="500"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTemplateColumn Header="关机类型" Width="120" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="20" Padding="8,4" 
                                        HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Normal">
                                                    <Setter Property="Background" Value="#c6f6d5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Abnormal">
                                                    <Setter Property="Background" Value="#fed7d7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Unexpected">
                                                    <Setter Property="Background" Value="#fed7d7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Forced">
                                                    <Setter Property="Background" Value="#fbb6ce"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Sleep">
                                                    <Setter Property="Background" Value="#e2e8f0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="UserInitiated">
                                                    <Setter Property="Background" Value="#c6f6d5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Restart">
                                                    <Setter Property="Background" Value="#bee3f8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Unknown">
                                                    <Setter Property="Background" Value="#e2e8f0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" FontWeight="500">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Normal">
                                                        <Setter Property="Foreground" Value="#22543d"/>
                                                        <Setter Property="Text" Value="正常关机"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Abnormal">
                                                        <Setter Property="Foreground" Value="#742a2a"/>
                                                        <Setter Property="Text" Value="异常关机"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Unexpected">
                                                        <Setter Property="Foreground" Value="#742a2a"/>
                                                        <Setter Property="Text" Value="意外关机"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Forced">
                                                        <Setter Property="Foreground" Value="#97266d"/>
                                                        <Setter Property="Text" Value="强制关机"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Sleep">
                                                        <Setter Property="Foreground" Value="#4a5568"/>
                                                        <Setter Property="Text" Value="睡眠"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="UserInitiated">
                                                        <Setter Property="Foreground" Value="#22543d"/>
                                                        <Setter Property="Text" Value="用户关机"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Restart">
                                                        <Setter Property="Foreground" Value="#2a4365"/>
                                                        <Setter Property="Text" Value="系统重启"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Unknown">
                                                        <Setter Property="Foreground" Value="#4a5568"/>
                                                        <Setter Property="Text" Value="未知"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="关机原因" 
                                        Binding="{Binding ShutdownReason}"
                                        Width="*" SortMemberPath="ShutdownReason"/>
                    
                    <DataGridTextColumn Header="进程" 
                                        Binding="{Binding Process}"
                                        Width="150" SortMemberPath="Process"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="#f8f9fa" 
                BorderBrush="#dee2e6" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           VerticalAlignment="Center" 
                           Margin="15,0" FontSize="13" 
                           Foreground="#495057"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                            VerticalAlignment="Center" Margin="15,0">
                    
                    <!-- 加载进度 -->
                    <TextBlock Text="{Binding LoadingProgress}" 
                               Visibility="{Binding IsLoading, 
                                          Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,0,12,0" FontSize="13" 
                               Foreground="#6c757d"/>
                    
                    <!-- 取消按钮 -->
                    <Button Content="取消" 
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsLoading, 
                                       Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="12,4" FontSize="12"
                            Background="#dc3545" Foreground="White" 
                            BorderBrush="#dc3545" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#c82333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载覆盖层 -->
        <Border Grid.RowSpan="5" 
                Background="#80000000"
                Visibility="{Binding IsLoading, 
                           Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" 
                    CornerRadius="15" 
                    Padding="40" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    MinWidth="300">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="8" BlurRadius="15" 
                                      Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- 动画加载图标 -->
                    <Ellipse Width="40" Height="40" Margin="0,0,0,20"
                             StrokeThickness="4" 
                             Stroke="#667eea"
                             StrokeDashArray="15,15">
                        <Ellipse.RenderTransform>
                            <RotateTransform CenterX="20" CenterY="20"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    
                    <TextBlock Text="正在加载数据..." 
                               FontSize="18" FontWeight="500"
                               Foreground="#333" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="请耐心等待，正在分析系统事件日志" 
                               FontSize="14" 
                               Foreground="#666" 
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>